# Server Configuration
NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000

# Database Connections
# MongoDB URI for Mongoose models & audit logs
MONGODB_URI=mongodb://127.0.0.1:27017/global_crm
# PostgreSQL / SQL URL for Prisma ORM
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/global_crm?schema=public

# Security & Cryptography (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
ENCRYPTION_MASTER_KEY=your-32-byte-base64-encryption-key-here==
JWT_ACCESS_SECRET=your-minimum-32-character-jwt-access-secret-key-12345
JWT_REFRESH_SECRET=your-minimum-32-character-jwt-refresh-secret-key-12345

# Optional OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
